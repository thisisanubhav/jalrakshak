# Copy to .env.local for local use. Never commit populated environment files.
# Full reference: docs/deployment/environment.md
# Local SQLite works with every value below left blank.

# Database: required on Vercel; blank selects SQLite on local/Docker installs.
DATABASE_URL=
# Optional SQLite paths; defaults: private-data/team.sqlite and private-data/backups.
JALRAKSHAK_TEAM_DB=
JALRAKSHAK_BACKUP_DIR=
# Required for hosted initial setup; local setup generates a private key if unset.
JALRAKSHAK_SETUP_TOKEN=
# HTTPS origin only, with no path; leave blank for ordinary HTTP localhost.
JALRAKSHAK_PUBLIC_ORIGIN=

# Public organisation signup: PostgreSQL + migrations + HTTPS origin required.
# Set to 1 only after configuration; blank keeps signup disabled.
JALRAKSHAK_ALLOW_SIGNUP=
# Google web OAuth client. Callback: <HTTPS origin>/api/onboarding/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gmail app password; used for contact messages and verification/invitation emails.
# Configure privately; never use your regular Google account password.
JALRAKSHAK_GMAIL_USER=
JALRAKSHAK_GMAIL_APP_PASSWORD=

# Optional hosted AI. No key means no hosted AI.
GROQ_API_KEY=
# groq, local or disabled. Blank selects Groq when a key exists, otherwise local.
JALRAKSHAK_AI_PROVIDER=
# Optional private AI services and model. See docs/field/local-ai.md.
JALRAKSHAK_OLLAMA_URL=
JALRAKSHAK_WHISPER_URL=
JALRAKSHAK_AI_MODEL=
# Optional downloaded multilingual model path for the local speech launcher.
JALRAKSHAK_WHISPER_MODEL=
