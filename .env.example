# Optional cloud sync endpoint. Leave blank to run fully offline/local demo mode.
NEXT_PUBLIC_SYNC_ENDPOINT=
# Explicitly enable demo controls (enabled by default in development).
NEXT_PUBLIC_DEMO_MODE=true

# Optional local AI companion services. Leave blank to keep AI unavailable.
# See docs/field/local-ai.md. Do not use NEXT_PUBLIC_ names for these settings.
JALRAKSHAK_OLLAMA_URL=
JALRAKSHAK_WHISPER_URL=
JALRAKSHAK_AI_MODEL=
# Optional path to a previously downloaded multilingual faster-whisper model.
JALRAKSHAK_WHISPER_MODEL=

# Optional automatic Contact Us delivery through Gmail. Server-only; never NEXT_PUBLIC_.
# Run node scripts/configure-contact-mail.mjs privately in Terminal.
JALRAKSHAK_GMAIL_USER=
JALRAKSHAK_GMAIL_APP_PASSWORD=

# Optional hosted PostgreSQL. Leave blank for local SQLite; required on Vercel.
DATABASE_URL=
# Required on Vercel: generate privately and never share or commit the value.
JALRAKSHAK_SETUP_TOKEN=
# Production HTTPS address; keep unset for ordinary localhost use.
JALRAKSHAK_PUBLIC_ORIGIN=
