# Copy to deploy/.env on the server; do not commit that file.
# DNS must point this hostname to the Docker server before startup.
JALRAKSHAK_DOMAIN=water.example.org
JALRAKSHAK_PUBLIC_ORIGIN=https://water.example.org
# Use a unique release/commit tag and retain the previous image for rollback.
JALRAKSHAK_IMAGE_TAG=pilot-1
# Production publishes only the HTTPS proxy. The app port remains private.
JALRAKSHAK_HTTP_BIND=80
JALRAKSHAK_HTTPS_BIND=443
