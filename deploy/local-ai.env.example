# Local Docker sandbox, separate from the native localhost:3000 database.
COMPOSE_PROJECT_NAME=jalrakshak-ai-local
COMPOSE_FILE=compose.yaml:compose.ai.yaml
JALRAKSHAK_DOMAIN=localhost
JALRAKSHAK_PUBLIC_ORIGIN=https://localhost:3443
JALRAKSHAK_HTTP_BIND=127.0.0.1:3080
JALRAKSHAK_HTTPS_BIND=127.0.0.1:3443
JALRAKSHAK_IMAGE_TAG=local
JALRAKSHAK_TIMEZONE=Asia/Kolkata
